# No configuration is needed to open the chat. Copy this to .env only when
# enabling a provider or an optional capability. Never commit the copied file.

# Preferred provider: Gemini through Vertex AI. Authenticate once on the host
# with `gcloud auth application-default login`, then set your Google Cloud
# project id and start Compose with docker-compose.vertex.yml (see README).
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global

# Alternative: Gemini Developer API (not Vertex AI).
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=

# Optional secondary providers.
# LLM_PROVIDER=groq
# GROQ_API_KEY=
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=

# Optional web research. Local audio analysis has a separate Compose overlay.
# ENABLE_WEB_RESEARCH=true
