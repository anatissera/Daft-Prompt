# Server-side only. Where the Next API routes proxy chat and compose, and where
# the /artifacts/* rewrite in next.config.mjs points.
# Local dev: uvicorn default. Production: your container host URL.
API_BASE_URL=http://localhost:8000

# Exposed to the browser, which uploads audio straight to it — a serverless
# function caps request bodies at 4.5 MB (25 seconds of WAV) and caps its own
# duration below what CPU stem separation takes.
#
# Leave unset locally: the upload then falls back to the /api/references/analyze
# proxy route, so dev needs no CORS configuration on the backend.
#
# Next inlines NEXT_PUBLIC_* at BUILD time — changing it needs a redeploy, not
# just a saved variable. The backend must also list this app's origin in
# CORS_ALLOW_ORIGINS.
# NEXT_PUBLIC_API_BASE_URL=https://your-backend.example.com

# Shared secret the proxy routes attach as X-API-Key. Must match the backend's
# API_KEY. Leave unset locally, where the backend leaves those routes open.
# API_KEY=
