# Phase 1 (walking skeleton) needs no LLM keys. These land in later phases:
# LLM_PROVIDER=gemini            # gemini | groq | openrouter | vertexai
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# Primary models by role. Gemini is the default provider; OpenRouter can be used
# as a fallback or selected directly via LLM_PROVIDER=openrouter.
# MODEL_DIRECTOR=gemini-2.5-flash
# MODEL_INSTRUMENT=gemini-2.5-flash
# MODEL_ARBITER=gemini-2.5-flash
# GEMINI_MODEL_FALLBACKS=gemini-2.5-flash-lite,gemini-2.0-flash
# OPENROUTER_MODEL_DIRECTOR=openrouter/free
# OPENROUTER_MODEL_INSTRUMENT=openrouter/free
# OPENROUTER_MODEL_ARBITER=openrouter/free
# OPENROUTER_MODEL_FALLBACKS=
# LLM_FALLBACK_PROVIDERS=gemini,openrouter
# Point the OpenRouter provider at any OpenAI-compatible endpoint (local
# llama-server, vLLM, etc.). Combine with LLM_PROVIDER=openrouter + any API key
# value and any model name your server accepts.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Vertex AI (uses Application Default Credentials — no API key needed)
# LLM_PROVIDER=vertexai
# GOOGLE_CLOUD_PROJECT=daft-prompt

# Free-tier guardrails. Keep RPM low to avoid parallel instrument calls burning
# through Gemini/OpenRouter limits; quota errors are surfaced to the UI instead
# of becoming empty instrument parts.
# LLM_MAX_RETRIES=1
# LLM_RPM_LIMIT=5
# LLM_FAIL_FAST_ON_QUOTA=true
# MAX_ROUNDS=3

# LangSmith tracing (optional — remove or set LANGSMITH_TRACING=false to disable)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=llm-band
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
