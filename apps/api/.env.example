# Phase 1 (walking skeleton) needs no LLM keys. These land in later phases:
# LLM_PROVIDER=gemini            # gemini | groq | openrouter | vertexai
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# Primary models by role. Gemini is the default provider; OpenRouter can be used
# as a fallback or selected directly via LLM_PROVIDER=openrouter.
# MODEL_DIRECTOR=gemini-2.5-flash
# MODEL_INSTRUMENT=gemini-2.5-flash
# MODEL_ARBITER=gemini-2.5-flash
# GEMINI_MODEL_FALLBACKS=gemini-2.5-flash-lite,gemini-2.0-flash
# OPENROUTER_MODEL_DIRECTOR=openrouter/free
# OPENROUTER_MODEL_INSTRUMENT=openrouter/free
# OPENROUTER_MODEL_ARBITER=openrouter/free
# OPENROUTER_MODEL_FALLBACKS=
# LLM_FALLBACK_PROVIDERS=gemini,openrouter
# Point the OpenRouter provider at any OpenAI-compatible endpoint (local
# llama-server, vLLM, etc.). Combine with LLM_PROVIDER=openrouter + any API key
# value and any model name your server accepts.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- OpenCode Go preset -----------------------------------------------------
# Flat-fee OpenAI-compatible gateway, driven through the `openrouter` provider
# slot. Note the /zen/go/ path — /zen/v1 is the metered Zen endpoint instead.
#
# Split by role on purpose: the director makes ONE call per compose but emits
# the whole DirectorOutput (key, tempo, form, roster, patch), so a mistake there
# costs the whole song — worth the bigger model. Instrument agents are the
# volume (see _FILL_MAX_WORKERS in band_agent/pipeline.py) and take the faster
# one. Available MiniMax ids: minimax-m3, minimax-m2.7, minimax-m2.5.
#
# Heads up: structured-output failures do NOT escalate to the next provider
# (see with_fallbacks in infrastructure/llm.py) — the fallback chain below
# covers quota and transport errors only. Truncated tool calls are absorbed by
# band_agent/tools/fallback_fill.py instead, at a cost in musical quality.
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://opencode.ai/zen/go/v1
# OPENROUTER_MODEL_DIRECTOR=minimax-m3
# OPENROUTER_MODEL_INSTRUMENT=minimax-m2.7
# OPENROUTER_MODEL_ARBITER=minimax-m3
# LLM_FALLBACK_PROVIDERS=gemini,groq

# Vertex AI (uses Application Default Credentials — no API key needed)
# LLM_PROVIDER=vertexai
# GOOGLE_CLOUD_PROJECT=daft-prompt

# Free-tier guardrails. Keep RPM low to avoid parallel instrument calls burning
# through Gemini/OpenRouter limits; quota errors are surfaced to the UI instead
# of becoming empty instrument parts.
#
# RAISE LLM_RPM_LIMIT ON A FLAT-FEE GATEWAY. The limiter is process-global and
# sleeps while holding its lock (_RateLimiter in infrastructure/llm.py), so it
# spaces EVERY call by 60/limit seconds and serialises the whole _FILL_MAX_WORKERS
# pool. At the free-tier default of 5 that is 12s per call: a compose makes
# roughly 18 (intent + director + one per instrument-section + arbiter), which
# is ~3.5 minutes of pure sleeping and pushed production composes to 320-460s.
# opencode.ai Go is flat-fee with spend caps, not RPM caps — it wants a high
# value here (the deployed service uses 120, i.e. 0.5s spacing).
# LLM_MAX_RETRIES=1
# LLM_RPM_LIMIT=5
# LLM_FAIL_FAST_ON_QUOTA=true
# MAX_ROUNDS=3

# Runtime paths. Both default to directories inside the repo (apps/api/outputs
# and apps/api/uploads), which is what docker-compose mounts. Override them on
# hosts whose filesystem is read-only or memory-backed — on Cloud Run only /tmp
# is writable, and anything written there counts against the instance's memory.
# ARTIFACTS_DIR=/tmp/outputs
# REFERENCE_UPLOAD_DIR=/tmp/uploads
# REFERENCE_UPLOAD_MAX_BYTES=52428800

# Where analysed references persist. Unset -> an in-memory dict (fine for local
# dev and tests; lost on restart). Set it to a durable directory — a mounted GCS
# bucket on Cloud Run — so references survive restarts and are shared across
# instances. Point ARTIFACTS_DIR at the same bucket to persist rendered songs;
# keep REFERENCE_UPLOAD_DIR on local /tmp (raw audio and Demucs stems are large
# and disposable).
# REFERENCE_STORE_DIR=/mnt/artifacts/references

# PORT is read by the container entrypoint (Cloud Run and most PaaS inject it).
# Defaults to 8000 locally.
# PORT=8080

# LangSmith tracing (optional — remove or set LANGSMITH_TRACING=false to disable)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=llm-band
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
